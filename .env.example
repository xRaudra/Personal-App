# Required: server-side access password. Never commit a real password.
PERSONAL_APP_PASSWORD=

# AI features
ANTHROPIC_API_KEY=

# Gmail: update the OAuth client's allowed redirect URI for the new deployment.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_REDIRECT_URI=https://YOUR-PROJECT.vercel.app/api/auth/gmail/callback

# Slack
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# WhatsApp via Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_TO=
